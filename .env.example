# Kru configuration. For `bun run start`, copy this to .env.local. For Docker,
# set these in docker-compose.yml or a .env file next to it.

# The exact address you open Kru at, including scheme and port. It's used for
# login cookies, cross-site checks, and the GitHub App's callback URLs. GitHub
# stores those URLs when the app is created, so set this before creating it.
APP_URL=http://localhost:3000
#KRU_PORT=3000

# Where Kru keeps its SQLite database and secret key. Back this folder up.
# Docker uses /data inside the container.
# KRU_DATA_DIR=./data

# Encrypts stored GitHub tokens and API keys. Optional: without it, Kru creates
# secret.key in the data folder on first start. Losing the key makes stored
# secrets unreadable. Generate one with: openssl rand -base64 32
# KRU_SECRET_KEY=

# One-time token for registering the only account. Optional: without it, Kru
# prints a random token in its logs while no account exists.
# KRU_SETUP_TOKEN=

# Session signing secret for login. Optional: derived from the secret key.
# BETTER_AUTH_SECRET=

# Listen address and port for the standalone server in Docker. `bun run dev`
# and `bun run start` always listen on 127.0.0.1.
# HOSTNAME=0.0.0.0
# PORT=3000

# Extra origins allowed to use the dev server, comma-separated (e.g. a LAN IP).
# KRU_DEV_ORIGINS=

# "Sign in with ChatGPT" returns to http://localhost:1455/auth/callback, an
# address OpenAI fixed. Outside Docker, Kru listens there itself and forwards
# to APP_URL. Set 0 to turn that off (then use the code sign-in instead).
# KRU_OAUTH_CALLBACK_PORT=1455

# ChatGPT sign-ins stream from OpenAI's Codex backend and fold the reply
# into one response. Set 0 to send plain non-streaming requests instead.
# KRU_CODEX_FORCE_STREAM=1

# The crew. How many cards it works at once, how many times Lulu may send a
# card back to Momo, and how many follow-ups a failing CI check may start on
# one pull request before the crew leaves it to you (a review from a person
# is never limited).
# KRU_BOT_CONCURRENCY=1
# KRU_BOT_REVIEW_ROUNDS=2
# KRU_PR_CHECK_FOLLOWUPS=3
# How many times the crew tries a card again after it failed on the work
# (0 never retries), and how hard Claude Code thinks per chat reply when it
# is the crew's chat model: low, medium or high (unset: the CLI's default).
# KRU_BOT_RETRIES=1
# KRU_BOT_EFFORT=
# On the box container: how long a bot's Claude Code session may sit idle
# before it is closed, in milliseconds.
# BOT_IDLE_MS=600000

# How many cards waiting for review keep their workspace in the box, so
# "ask for changes" continues in it. 0 clones again every time.
# KRU_REVIEW_WORKSPACES=3

# Use a GitHub App you created yourself instead of the setup page.
# Set all four or none; a partial set is ignored.
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# The box: the container where agents clone repos and run commands (see
# box/). Required to run agents. Docker Compose sets these up; on bare
# metal, run the box image yourself and point Kru at it.
# KRU_BOX_URL=http://127.0.0.1:8787
# Shared secret; set the same value as BOX_TOKEN on the box container.
# KRU_BOX_TOKEN=
# Or, instead of a token, the folder where the box's state volume is mounted.
# KRU_BOX_STATE_DIR=/box-state
